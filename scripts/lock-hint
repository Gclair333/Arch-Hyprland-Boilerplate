#!/bin/sh
# lock-hint — the warning line under hyprlock's password box. Prints nothing
# when there's nothing to warn about, so the label stays invisible.
#
#   Caps Lock is on
#   One more wrong password locks you out for 10 minutes
#   Too many wrong passwords: locked until 6:30 PM (8 min).
#   Even the right password won't work until then.
#
# Why the lockout line exists: Arch's pam_faillock locks the account after 3
# wrong passwords in 15 minutes (any mix of lock screen, login screen, sudo)
# and then refuses even the correct one for 10 minutes. hyprlock's own message
# for that only flashes briefly, so it reads like "my password stopped working".
# The limits come from /etc/security/faillock.conf (deny, fail_interval,
# unlock_time); the counter lives in /run/faillock and clears on reboot.
#
# hyprlock.conf runs this every second while locked. The common case is one
# file test, so it's cheap. FAILLOCK_DIR points it elsewhere for testing.

set -u

user=$(id -un)
dir="${FAILLOCK_DIR:-/run/faillock}"

conf_value() { # key default
    v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p" \
        /etc/security/faillock.conf 2>/dev/null | tail -n 1)
    echo "${v:-$2}"
}

# Caps Lock: any keyboard's LED counts (laptop keyboard, USB receiver, ...).
for led in /sys/class/leds/*::capslock/brightness; do
    [ -r "$led" ] && [ "$(cat "$led")" != "0" ] && { echo "Caps Lock is on"; break; }
done

# An empty tally file means no recent failures: the usual case, done here.
[ -s "$dir/$user" ] || exit 0

deny=$(conf_value deny 3)
interval=$(conf_value fail_interval 900)
unlock=$(conf_value unlock_time 600)
now=$(date +%s)

# faillock prints one line per failure: "YYYY-MM-DD HH:MM:SS <type> <source> V".
# Only valid (V) failures inside fail_interval count, as in pam_faillock itself.
count=0
latest=0
for t in $(faillock --dir "$dir" --user "$user" 2>/dev/null |
           awk '/^[0-9]{4}-[0-9]{2}-[0-9]{2} / && $NF == "V" {print $1 "_" $2}'); do
    ts=$(date -d "$(echo "$t" | tr _ ' ')" +%s 2>/dev/null) || continue
    [ $((ts + interval)) -ge "$now" ] || continue
    count=$((count + 1))
    [ "$ts" -gt "$latest" ] && latest=$ts
done

[ "$deny" -gt 0 ] || exit 0

if [ "$count" -ge "$deny" ]; then
    if [ "$unlock" -eq 0 ]; then
        echo "Too many wrong passwords: locked until someone with sudo runs"
        echo "faillock --reset --user $user"
    elif [ $((latest + unlock)) -gt "$now" ]; then
        until=$(date -d "@$((latest + unlock))" '+%-I:%M %p')
        mins=$(( (latest + unlock - now + 59) / 60 ))
        echo "Too many wrong passwords: locked until $until ($mins min)."
        echo "Even the right password won't work until then."
    fi
elif [ "$count" -eq $((deny - 1)) ] && [ "$count" -gt 0 ]; then
    echo "One more wrong password locks you out for $(( (unlock + 59) / 60 )) minutes"
fi
