{
	// Waybar 0.15.0 — gaps are handled in style.css via per-module margin,
	// so "spacing" stays 0 to avoid doubling them up.
	"layer": "top",
	"position": "top",
	"height": 34,
	"margin-top": 6,
	"margin-left": 8,
	"margin-right": 8,
	"spacing": 0,

	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["cpu", "memory", "group/brightness", "group/volume", "network", "battery"],

	"hyprland/workspaces": {
		// Swap to "{icon}" plus a format-icons map if you want glyphs instead of numbers.
		"format": "{name}",
		"on-click": "activate",
		"persistent-workspaces": {
			"*": 5
		}
	},

	"cpu": {
		"format": "󰻠 {usage}%",
		"interval": 3,
		"tooltip-format": "CPU\n{usage}% in use\nLoad average: {load}"
	},

	"memory": {
		"format": "󰍛 {percentage}%",
		"interval": 3,
		"tooltip-format": "RAM\n{used:0.1f} GiB used of {total:0.1f} GiB ({percentage}%)\n{avail:0.1f} GiB available"
	},

	// --- brightness: click the pill to slide out a drag bar ---
	// The leader (icon + %) is always visible; left-click reveals the slider.
	// Waybar writes brightness through logind, so no brightnessctl or video
	// group is needed. Scroll on the leader still works as a shortcut.
	"group/brightness": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"children-class": "drawer-child",
			"click-to-reveal": true
		},
		"modules": ["backlight", "backlight/slider"]
	},

	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": ["󰃞", "󰃟", "󰃠"],
		"scroll-step": 5,
		"tooltip-format": "Brightness\n{percent}%\nClick for slider, scroll to adjust"
	},

	"backlight/slider": {
		"min": 5,
		"max": 100,
		"orientation": "horizontal",
		"device": "intel_backlight"
	},

	// --- volume ---
	// Click the pill to reveal a mute button + drag slider. The leader
	// (pulseaudio) must stay free of on-click-* handlers: Waybar attaches a
	// click-swallowing handler to any module that has one, which blocks the
	// drawer's left-click reveal. Groups don't dispatch on-click-* at all, so
	// mute lives on a dedicated custom module that reveals with the slider.
	// Volume is set through the PipeWire/PulseAudio API directly, no wpctl.
	"group/volume": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"children-class": "drawer-child",
			"click-to-reveal": true
		},
		"modules": ["pulseaudio", "custom/mute", "pulseaudio/slider"]
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 muted",
		"format-icons": {
			"headphone": "󰋋",
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"scroll-step": 5,
		"max-volume": 100,
		"smooth-scrolling-threshold": 1,
		"tooltip-format": "Volume\n{desc}\n{volume}% - click for slider + mute, scroll to adjust"
	},

	"custom/mute": {
		// Icon tracks mute state; exec re-runs after the click, so it flips
		// immediately. The interval is only a backstop for the media key.
		"exec": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo 󰝟 || echo 󰕾",
		"interval": 3,
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"tooltip-format": "Toggle mute"
	},

	"pulseaudio/slider": {
		"min": 0,
		"max": 100,
		"orientation": "horizontal"
	},

	"network": {
		"format-wifi": "󰤨 {essid}",
		"format-ethernet": "󰈀 {ifname}",
		"format-disconnected": "󰤭 offline",
		// nmtui in a floating kitty window; the float rule lives in hyprland.conf.
		"on-click": "kitty --class nmtui-float nmtui",
		"tooltip-format-wifi": "Wi-Fi\n{essid} ({signalStrength}%)\n{ipaddr}\nClick to manage networks",
		"tooltip-format-ethernet": "Ethernet\n{ifname}\n{ipaddr}\nClick to manage connections",
		"tooltip-format-disconnected": "Offline\nClick to connect"
	},

	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
		"tooltip-format": "Battery\n{capacity}% - {timeTo}"
	},

	"clock": {
		// Left-click toggles between time and date.
		"format": "󰥔 {:%I:%M %p}",
		"format-alt": "󰃭 {:%a %d %b}",
		"tooltip-format": "<tt>{calendar}</tt>"
	}
}
