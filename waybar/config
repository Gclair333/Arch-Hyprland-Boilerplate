{
	// Waybar 0.15.0 — gaps are handled in style.css via per-module margin,
	// so "spacing" stays 0 to avoid doubling them up.
	"layer": "top",
	"position": "top",
	"height": 34,
	"margin-top": 6,
	"margin-left": 8,
	"margin-right": 8,
	"spacing": 0,

	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["cpu", "memory", "pulseaudio", "network", "battery"],

	"hyprland/workspaces": {
		// Swap to "{icon}" plus a format-icons map if you want glyphs instead of numbers.
		"format": "{name}",
		"on-click": "activate",
		"persistent-workspaces": {
			"*": 5
		}
	},

	"cpu": {
		"format": "󰻠 {usage}%",
		"interval": 3,
		"tooltip-format": "CPU\n{usage}% in use\nLoad average: {load}"
	},

	"memory": {
		"format": "󰍛 {percentage}%",
		"interval": 3,
		"tooltip-format": "RAM\n{used:0.1f} GiB used of {total:0.1f} GiB ({percentage}%)\n{avail:0.1f} GiB available"
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 muted",
		"format-icons": {
			"headphone": "󰋋",
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		// Waybar's own scroll handling updates the readout instantly, which the
		// old shell-based on-scroll-* handlers did not. smooth-scrolling-threshold
		// is what makes hi-res touchpad scroll events register at all.
		"scroll-step": 5,
		"max-volume": 100,
		"smooth-scrolling-threshold": 1,
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"tooltip-format": "Volume\n{desc}\n{volume}% - scroll to adjust, click to mute"
	},

	"network": {
		"format-wifi": "󰤨 {essid}",
		"format-ethernet": "󰈀 {ifname}",
		"format-disconnected": "󰤭 offline",
		// nmtui in a floating kitty window; the float rule lives in hyprland.conf.
		"on-click": "kitty --class nmtui-float nmtui",
		"tooltip-format-wifi": "Wi-Fi\n{essid} ({signalStrength}%)\n{ipaddr}\nClick to manage networks",
		"tooltip-format-ethernet": "Ethernet\n{ifname}\n{ipaddr}\nClick to manage connections",
		"tooltip-format-disconnected": "Offline\nClick to connect"
	},

	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
		"tooltip-format": "Battery\n{capacity}% - {timeTo}"
	},

	"clock": {
		// Left-click toggles between time and date.
		"format": "󰥔 {:%I:%M %p}",
		"format-alt": "󰃭 {:%a %d %b}",
		"tooltip-format": "<tt>{calendar}</tt>"
	}
}
